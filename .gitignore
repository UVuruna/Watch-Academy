# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage

# Build output (M7 pipeline)
build/
dist/
*.spec
setup/cert/
setup/version_info.txt
setup/_version_info.py

# Owner's local-only experiments and notes
design/example/
DESIGN.txt

# Owner's Illustrator workspace (the PATH to the assets, not the app —
# the exported bundle copies in assets/ ARE committed). The FOLDER DOC is
# the one exception: the navigation chain from README.md must hold on a
# fresh clone (tests/test_doc_links.py), so the .md travels, the 160 MB
# of .ai masters do not.
illustrator/*
!illustrator/___illustrator.md
# Owner's raw guide screenshots (the ordered copies in assets/guide/
# ARE committed)
guide_new/

# Owner's design masters (working art, intentionally untracked — the
# downscaled bundle copies live in assets/skins/ and ARE committed)
design/background/
design/date/
design/hours/
design/pointer/
design/weekday/

# Owner's ChatGPT staging inbox (the mapped canonical copies in
# assets/<root>/chatgpt/ ARE committed). Anchored to the root — a bare
# chatGPT/ would also swallow assets/*/chatgpt/ (Windows matches
# case-insensitively).
/chatGPT/

# The Deep Time pack (~60-90 MB) — regenerate via setup/make_deep_time.py
# from the research events database; the M7 FULL installer bundles it.
Database/deep_time.sqlite

# Legacy exclusions
Database_Create/
Side/
Database/seasons_xxl.json
test.py
test2.py
FINAL.txt
assets/guide/new/
Clock_OuterColors.png
numbers/

# The owner's personal drop folder (his initials)
UV/

# The metal transformer's verification output — contact sheets and
# variants regenerated by `python -m recolor --plates ...` (recolor/preview.md)
research/recolor_preview/

# Claude — the session's own scratch stays local, but the ENFORCEMENT
# must travel: `settings.json` carries the PostToolUse/Stop hooks that
# run tests/run_guards.py (rules/CODE.md -> Enforcement), and the verify
# skill is this project's build/launch recipe. `settings.local.json` is
# personal (per-machine permission grants) and stays out.
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/settings.local.json

